# AWS Bedrock — credentials come from the standard boto3 chain:
#   ~/.aws/credentials, env vars (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY),
#   or IAM role. No API key is stored here.
AWS_REGION=us-east-1

# Model configuration
LLM_MODEL=anthropic.claude-3-haiku-20240307-v1:0
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Storage paths
CHROMA_PATH=./chroma_data
UPLOAD_DIR=./uploads

# Pipeline parameters
TOP_K=5
SIMILARITY_THRESHOLD=0.75
DRAFT_TEMPERATURE=0.2
VERIFY_TEMPERATURE=0.0

# Parallelism (max concurrent Bedrock calls)
MAX_WORKERS=5
